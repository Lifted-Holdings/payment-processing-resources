{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liftedpayments.com/assets/data/payment-statement-audit.schema.json",
  "title": "Payment Processing Statement Audit",
  "description": "A processor-neutral structure for summarizing a monthly merchant processing statement without cardholder data.",
  "type": "object",
  "required": ["statement_period", "card_volume", "transaction_count", "total_processing_fees", "effective_rate", "pricing_model", "fee_groups"],
  "properties": {
    "statement_period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "currency": { "type": "string", "const": "USD", "default": "USD" },
    "card_volume": { "type": "number", "minimum": 0 },
    "transaction_count": { "type": "integer", "minimum": 0 },
    "total_processing_fees": { "type": "number", "minimum": 0 },
    "effective_rate": { "type": "number", "minimum": 0, "description": "Total processing fees divided by card volume, expressed as a decimal." },
    "average_ticket": { "type": "number", "minimum": 0 },
    "pricing_model": { "type": "string", "enum": ["interchange_plus", "flat_rate", "tiered", "subscription", "dual_pricing", "unknown"] },
    "fee_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "amount"],
        "properties": {
          "category": { "type": "string", "enum": ["interchange", "assessments", "processor_markup", "authorization", "monthly", "pci", "equipment", "chargebacks", "other"] },
          "amount": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "review_notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
